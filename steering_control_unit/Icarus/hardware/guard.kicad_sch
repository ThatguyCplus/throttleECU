	(text "Trips when |VT_EPS - VT_SNS| > 0.25 V on either line, or the VT3+VT6 sum moves > 0.10 V (TBD-DATA). A trip latches until key-off and cuts every coil (SM-15). GUARD_TEST forces a trip for the key-on self-test (SM-17)."
		(exclude_from_sim no)
		(at 15 32 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "699a02a3-4531-544d-938a-d57dfbba682a")
