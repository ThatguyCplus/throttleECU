	)
	(text "Pins from SPNS186C. ESM nERROR into the enable gate (SM-03). Core 1.2 V from TLV733P-Q1 (power sheet), supervised into nPORRST together with the TPS3850. 16 MHz crystal on OSCIN/OSCOUT, load caps to KELVIN_GND only. Expected-Delta reference from N2HET PWM + RC (no DAC on this part)."
		(exclude_from_sim no)
		(at 15 32 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
