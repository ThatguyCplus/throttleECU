	(text "CH-C analog guard (no software, +5V0_B)"
		(exclude_from_sim no)
		(at 15 22 0)
		(effects
			(font
				(size 3.0 3.0)
			)
			(justify left bottom)
		)
		(uuid "5b13c37e-a250-5281-a284-aa0bdcf1e812")
	)
	(text "Trips when the overlay actually applied (VT_EPS - VT_SNS) differs from CH-B's own expected Delta by > 0.25 V on either line (R2 / SM-20), or the VT3+VT6 sum moves > 0.10 V (TBD-DATA). A trip latches until key-off and cuts every coil (SM-15). GUARD_TEST forces a trip for the key-on self-test (SM-17). VMID_B and the ladder are ratiometric to +3V3_B, the CH-B DAC reference."
		(exclude_from_sim no)
		(at 15 32 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
