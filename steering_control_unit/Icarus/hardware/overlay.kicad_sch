	(text "EPS gets OVL = RAW + (DELTA - VMID). DELTA = VMID + k(DAC - VMID), k = 10k/92k = 0.109 -> Delta_max = +/-0.18 V (TBD-DATA, SM-05). One DAC + inverter makes VT6 = -Delta (SM-06). Summing resistors 0.1 %."
		(exclude_from_sim no)
		(at 15 32 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "727215ae-e1f4-5aaf-a12f-34b341a7f4ab")
	)
