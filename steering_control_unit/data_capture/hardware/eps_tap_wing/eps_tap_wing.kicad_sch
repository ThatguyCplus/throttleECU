	(text "EPS tap FeatherWing: input front end for the Honda Insight EPS logger"
		(exclude_from_sim no)
		(at 20 20 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left bottom)
		)
		(uuid "2d11a80c-acb0-5051-a0ff-210a134ebb39")
	)
	(text "Taps connect at the EPS control unit, connector B (14P green) and A2 (+B). Every car-facing\nline goes through >=100 kOhm (1 MOhm for the torque sensor) before anything else, so a fault on\nthe logger side can't load the EPS. Fit the plug with the ignition OFF. See ../../BOM.md.\nJP1-JP14 (open as shipped) short the series resistors: bridge them only when the resistors\nare fitted at the probe ends instead."
		(exclude_from_sim no)
		(at 20 30 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "abe814c6-7004-5184-a9bf-40988ce936b6")
	)
