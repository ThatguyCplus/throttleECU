	(text "Bench stimulus FeatherWing: 12 V power, SAS power + CAN pass-through, EPS NEP/VSP/torque stimulus"
		(at 20 20 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left bottom)
		)
		(uuid "b9f218a2-7111-5dc7-a5db-e02ccbca85db")
	)
	(text "Every EPS line goes through a relay whose NC contact is the car's own wire: no power, no ARM loop or\nno enable bit means the EPS sees the car exactly as without this board. ARM loop on J5 (pins 7-8): wire\nan NC e-stop or key switch. Faking VT3/VT6 makes the motor steer: wheels off the ground, hands clear.\nAll enables come from U4 (TCA9534), which powers up with every pin an input; 100k pull-downs hold\nevery driver off until firmware sets the bit."
		(at 20 30 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "93ea9ac6-0245-5cf5-9e1e-56f458459f60")
	)
	(text "Feather M4 CAN (stacking headers)"
		(at 20 60 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "25568a5b-1528-547c-8a0d-0a907817fed8")
	)
