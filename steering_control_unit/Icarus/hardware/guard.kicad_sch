	(text "CH-C analog guard (no software, +5V0_B)"
		(exclude_from_sim no)
		(at 15 22 0)
		(effects
			(font
				(size 3.0 3.0)
			)
			(justify left bottom)
		)
		(uuid "5b13c37e-a250-5281-a284-aa0bdcf1e812")
	)
	(text "Trips when the overlay actually applied (VT_EPS - VT_SNS) differs from CH-B's own expected Delta by > 0.25 V on either line (R2 / SM-20), or the VT3+VT6 sum moves > 0.10 V (TBD-DATA). A trip latches until key-off and cuts every coil (SM-15). GUARD_TEST forces a trip for the key-on self-test (SM-17). VMID_B and the ladder are ratiometric to +3V3_B, the CH-B DAC reference."
		(exclude_from_sim no)
		(at 15 32 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "629c2c26-dfc9-5fcf-b05c-34f622bb3c2f")
	)
	(text "Buffers (1 MOhm from the car side) and VMID_B"
		(exclude_from_sim no)
		(at 15.0 48.5 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "7eb46cbc-c6fc-5b60-a6a9-fa6c31f7321d")
	)
	(text "Expected-Delta reference from CH-B's own DAC (R2 / SM-20): REF3 = VMID - Delta_exp, REF6 = VMID + Delta_exp"
		(exclude_from_sim no)
		(at 15.0 106.82 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "8d505dec-8080-52c0-9125-807c4c7628ba")
	)
	(text "Difference amps: D3 = EPS3 - RAW3 + REF3 (= VMID when the applied Delta matches the expected), D6 likewise, S = (EPS3+EPS6) - (RAW3+RAW6) + VMID"
		(exclude_from_sim no)
		(at 15.0 165.14 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "33f9c116-33aa-5b84-b4b4-e5172a50bd70")
	)
	(text "Window thresholds (ladder from +3V3_B) and comparators (TLV1704-Q1, open collector)"
		(exclude_from_sim no)
		(at 15.0 223.45999999999998 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "a873aa6e-943c-52a9-84d3-a955ac32ea61")
	)
