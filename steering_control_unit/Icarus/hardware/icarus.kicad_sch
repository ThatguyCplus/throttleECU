	(lib_symbols)
	(text "Icarus rev 0.7 - dual-channel, triple-shutdown steering torque-overlay unit"
		(exclude_from_sim no)
		(at 20 25 0)
		(effects
			(font
				(size 3.5 3.5)
			)
			(justify left bottom)
		)
		(uuid "fa583cff-03ac-5b91-8cc0-675b51bbfeb5")
	)
	(text "CH-A (F280049C-Q1) computes the overlay; CH-B (F280049C-Q1) monitors it; CH-C is an analog guard with no software.\nOverlay reaches the EPS only through relays K1 AND K2; each coil needs CH-A high side + CH-B low side + CH-C guard FET.\nWith no power or any enable missing, NC contacts connect the OEM torque sensor straight to the EPS.\nSafety concept: ../docs/04_TECHNICAL_SAFETY_CONCEPT.md. Values marked TBD-DATA wait for logger measurements."
		(exclude_from_sim no)
		(at 20 35 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "eb6b6299-affe-5b5a-ae19-241467b77607")
	)
